# Copy to /etc/sysconfig/grype.crunchtools.com on the host. No secrets live here
# — the scanner holds no credential (the quay fleet is public and anonymous).
# The rebuilder verb, when it ships, gets its own separate env file and token.

# The image to run, pinned to a deliberately deployed release tag (not :latest
# by accident — name the tag you deployed).
GRYPE_IMAGE=quay.io/crunchtools/grype:latest
