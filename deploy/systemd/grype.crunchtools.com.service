# /srv copy: /srv/grype.crunchtools.com/config/grype.crunchtools.com.service
#
# A ONESHOT, not a server. Kagetora's 6h timer starts this; it scans the fleet
# with grype and exits. It writes cve.status to the SHARED /var/lib/grype-scan,
# statically labelled container_file_t with NO MCS category and mounted with NO
# :z/:Z, so the confined nagios-agent container can also read it — the same
# cross-container pattern as /var/lib/deployer. ExecStartPost restorecon's the
# output on the host so the file always carries that shared label regardless of
# how the container wrote it.
#
# PINNED to a release tag, and NO io.containers.autoupdate label: like the
# deployer, a oneshot is not running at 03:00, so nothing auto-updates it;
# upgrading it is a /srv commit and a `systemctl daemon-reload` by a person who
# read the changelog.
#
# WHY label=disable. The scanner's podman provider reads images through the
# podman socket, which is root-equivalent; a confining type would add nothing
# over the authority the socket already grants, and disable lets it write the
# shared dir and read the DB cache without per-mount relabel churn. Same
# reasoning the deployer unit records for its own socket access.

[Unit]
Description=Podman container - grype.crunchtools.com (fleet CVE scanner, oneshot)
Documentation=https://github.com/crunchtools/grype
Requires=podman.socket
After=network-online.target podman.socket

[Service]
Type=oneshot
TimeoutStartSec=1800
ExecStartPre=-/usr/bin/podman rm -f grype.crunchtools.com
ExecStart=/usr/bin/podman run --rm --name grype.crunchtools.com \
    --label PODMAN_SYSTEMD_UNIT=grype.crunchtools.com.service \
    --security-opt label=disable \
    --read-only -v grype-tmp:/tmp -e TMPDIR=/tmp \
    --memory=4g --memory-swap=4g \
    -e CONTAINER_HOST=unix:///run/podman/podman.sock \
    -e STATE_DIR=/var/lib/grype-scan \
    -e FLEET_CONF=/etc/grype/fleet-images.conf \
    -v /run/podman/podman.sock:/run/podman/podman.sock \
    -v grype-db:/var/cache/grype \
    -v /var/lib/grype-scan:/var/lib/grype-scan \
    -v /srv/grype.crunchtools.com/config/fleet-images.conf:/etc/grype/fleet-images.conf:ro \
    quay.io/crunchtools/grype:0.1.0 \
    cve-scan
ExecStartPost=/usr/sbin/restorecon -RF /var/lib/grype-scan
ExecStopPost=-/usr/bin/podman rm -f grype.crunchtools.com

[Install]
WantedBy=multi-user.target
